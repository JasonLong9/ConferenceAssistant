# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Whisper模型配置（可选）
WHISPER_MODEL_PATH=./models/whisper-large-v3
WHISPER_DEVICE=auto

# CUDA配置（可选，指定使用的GPU设备）
CUDA_VISIBLE_DEVICES=0

# 服务器配置
HOST=0.0.0.0
PORT=8080

# 输出目录配置
OUTPUT_DIR=./outputs

# 调试模式
DEBUG=false

# 语言配置
DEFAULT_LANGUAGE=zh